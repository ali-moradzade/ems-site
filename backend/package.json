  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_ENV=development nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test vitest run --config vitest.config.mts --no-file-parallelism",
    "test:watch": "NODE_ENV=test vitest --watch",
    "test:cov": "NODE_ENV=test vitest --coverage",
    "test:e2e": "NODE_ENV=test vitest run --config test/vitest.config.e2e.mts --no-file-parallelism"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.9",
